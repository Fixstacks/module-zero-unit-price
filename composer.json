    "type": "magento2-module",
    "version": "1.3.0",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "authors": [
        {
            "name": "Roman Pasichnyk"
        }
    ],
    "homepage": "https://fixstacks.com/zero",
    "keywords": [
        "magento",
        "magento2",
        "magento-open-source",
        "zero",
        "unit-price",
        "base-price",
        "grundpreis",
        "eu"
    ],
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0",
        "magento/framework": "103.0.*",
        "magento/module-backend": "*",
        "magento/module-catalog": "*",
        "magento/module-config": "*",
        "magento/module-eav": "*",
        "magento/module-store": "*",
